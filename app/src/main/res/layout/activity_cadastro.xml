<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/perfil_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/perfil_bg_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar nova conta"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Preencha os dados para se cadastrar"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome Completo"
                    android:textColor="@color/perfil_texto_sec"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/nome_edt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Digite seu nome"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/perfil_texto"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPF"
                    android:textColor="@color/perfil_texto_sec"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/cpf_edt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="000.000.000-00"
                    android:inputType="number"
                    android:maxLength="14"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/perfil_texto"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail"
                    android:textColor="@color/perfil_texto_sec"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/email_cadastro_edt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="seu@email.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/perfil_texto"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textColor="@color/perfil_texto_sec"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/senha_cadastro_edt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/rounded_corner"
                    android:hint="Mínimo 6 caracteres"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/perfil_texto"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/finalizarCadastroBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/perfil_teal"
                    android:text="Finalizar Cadastro"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/voltarLoginBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Voltar para o Login"
                    android:textColor="@color/perfil_teal"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>