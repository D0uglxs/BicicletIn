<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#74B9E2"
    android:padding="16dp">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/icon_bike"
        android:contentDescription="logo do app"/>

    <EditText
        android:id="@+id/usuario_edt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Usuario"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:textSize="20sp"
        android:background="@drawable/rounded_corner"
        android:padding="18dp"
        android:inputType="text" />

    <EditText
        android:id="@+id/senha_edt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Senha"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:textSize="20sp"
        android:background="@drawable/rounded_corner"
        android:padding="18dp"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/entrar_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrar"
        android:backgroundTint="@color/white"
        android:textSize="20sp"
        android:padding="18dp"
        android:layout_marginTop="32dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/registrar_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:layout_marginTop="10dp"
        android:paddingTop="10dp"
        android:text="Não possui conta? Registre-se"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="20sp" />

</LinearLayout>